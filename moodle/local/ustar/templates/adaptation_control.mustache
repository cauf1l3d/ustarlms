<div class="u-product-page u-adapt-control">
<header class="u-product-head"><div><p class="u-page-kicker">HRD · Контроль</p><h1>Адаптация</h1><p>Эскалации, просрочки и итоговые решения по назначенным адаптационным циклам.</p></div><div class="u-product-head__actions"><a class="u-btn" href="{{operationsurl}}">← Контроль</a></div></header>
<section class="u-stat-grid u-stat-grid--4"><article class="u-stat-card"><span>Активных циклов</span><strong>{{activecount}}</strong></article><article class="u-stat-card"><span>Новых сигналов</span><strong>{{opencount}}</strong></article><article class="u-stat-card"><span>В контроле</span><strong>{{incontrolcount}}</strong></article><article class="u-stat-card"><span>Критических</span><strong>{{criticalcount}}</strong></article></section>

{{#hascycles}}<section class="u-panel"><header class="u-panel-title"><div><p class="u-page-kicker">Реестр</p><h2>Все адаптации</h2><p>Полная история ежедневных листов сотрудника и руководителя доступна независимо от наличия эскалаций.</p></div></header><div class="u-adapt-case-list">{{#cycles}}<article class="u-adapt-case"><div class="u-adapt-case__main"><div><strong>{{employee}}</strong><span>{{position}} · руководитель {{manager}}</span></div><span class="u-adapt-case__badge">{{statuslabel}}</span></div><p>Заполнено парных дней: {{paireddays}} / {{plannedworkdays}}</p><div class="u-adapt-case__actions"><a class="u-btn u-btn--primary" href="{{detailurl}}">Открыть историю</a></div></article>{{/cycles}}</div></section>{{/hascycles}}
{{^hascycles}}<div class="u-empty-state"><h3>Адаптаций пока нет</h3><p>После назначения руководителем циклы появятся в этом реестре.</p></div>{{/hascycles}}

{{#hascases}}<section class="u-panel"><header class="u-panel-title"><div><p class="u-page-kicker">Очередь HRD</p><h2>Требуют внимания</h2></div></header><div class="u-adapt-case-list">{{#cases}}<article class="u-adapt-case {{#critical}}is-critical{{/critical}}"><div class="u-adapt-case__main"><div><strong>{{employee}}</strong><span>{{position}} · руководитель {{manager}}</span></div><span class="u-adapt-case__badge">{{#critical}}Критично{{/critical}}{{#warning}}Внимание{{/warning}}</span></div><p>{{summary}}</p><small>{{#hasworkdate}}Рабочая дата {{workdate}} · {{/hasworkdate}}открыто {{openedat}}</small><div class="u-adapt-case__actions"><a class="u-btn" href="{{detailurl}}">Открыть адаптацию</a>{{#isopen}}<form method="post"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="takecase"><input type="hidden" name="adaptationid" value="{{adaptationid}}"><input type="hidden" name="fingerprint" value="{{fingerprint}}"><button class="u-btn u-btn--primary" type="submit">Взять в контроль</button></form>{{/isopen}}<span>{{#isincontrol}}В контроле HRD{{/isincontrol}}</span></div></article>{{/cases}}</div></section>{{/hascases}}
{{^hascases}}<div class="u-empty-state"><h3>Открытых эскалаций нет</h3><p>Сигналы появятся здесь автоматически по правилам адаптации.</p></div>{{/hascases}}

{{#hasdetail}}{{#detail}}<section class="u-panel u-adapt-detail"><header class="u-panel-title"><div><p class="u-page-kicker">Адаптация #{{id}}</p><h2>{{employee}}</h2><p>{{position}} · руководитель {{manager}} · {{paireddays}} / {{plannedworkdays}} парных рабочих дней</p></div>{{#profileurl}}<a class="u-btn" href="{{profileurl}}">Профиль сотрудника</a>{{/profileurl}}</header>
{{#hascases}}<div class="u-adapt-detail-cases"><h3>Открытые сигналы</h3>{{#cases}}<article class="u-adapt-detail-case {{#critical}}is-critical{{/critical}}"><strong>{{summary}}</strong><span>{{status}}</span><form method="post"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="resolvecase"><input type="hidden" name="adaptationid" value="{{id}}"><input type="hidden" name="fingerprint" value="{{fingerprint}}"><textarea name="resolution" rows="2" required placeholder="Результат разбора"></textarea><button class="u-btn" type="submit">Закрыть сигнал</button></form></article>{{/cases}}</div>{{/hascases}}
{{#hasdays}}<h3>Ежедневная история</h3><div class="u-adapt-days">{{#days}}<article><strong>{{date}}</strong><div class="u-adapt-day-cols"><div><b>Сотрудник</b>{{#hasemployee}}{{#employee}}<span>Готовность: {{ready}}</span><span>Помощь: {{help}}</span><p>{{difficult}}</p>{{#action}}<small>Действие: {{action}}</small>{{/action}}{{/employee}}{{/hasemployee}}{{^hasemployee}}<span>Не заполнено</span>{{/hasemployee}}</div><div><b>Руководитель</b>{{#hasmanager}}{{#manager}}<span>Готовность: {{ready}}</span><span>Помощь: {{help}}</span><p>{{difficult}}</p>{{#action}}<small>Действие: {{action}}</small>{{/action}}{{/manager}}{{/hasmanager}}{{^hasmanager}}<span>Не заполнено</span>{{/hasmanager}}</div></div></article>{{/days}}</div>{{/hasdays}}
<div class="u-adapt-final-grid"><section><h3>Итог сотрудника</h3>{{#hasemployeefinal}}{{#employeefinal}}<p><b>Готовность:</b> {{ready}}</p><p>{{risks}}</p>{{/employeefinal}}{{/hasemployeefinal}}{{^hasemployeefinal}}<p>Не заполнено</p>{{/hasemployeefinal}}</section><section><h3>Итог руководителя</h3>{{#hasmanagerfinal}}{{#managerfinal}}<p><b>Готовность:</b> {{ready}}</p><p>{{risks}}</p>{{/managerfinal}}{{/hasmanagerfinal}}{{^hasmanagerfinal}}<p>Не заполнено</p>{{/hasmanagerfinal}}</section></div>
{{#escalated}}<section class="u-adapt-hrd-decision"><h3>Решение HRD</h3><form method="post"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="hrdfinal"><input type="hidden" name="adaptationid" value="{{id}}"><label><input type="radio" name="decision" value="complete" required> Завершить адаптацию</label><label><input type="radio" name="decision" value="extend" required> Продлить адаптацию</label><label>Добавить рабочих дней<input type="number" name="extensiondays" min="1" max="180" value="3"></label><label>Решение / основание<textarea name="reason" rows="3" required></textarea></label><button class="u-btn u-btn--primary" type="submit">Сохранить решение HRD</button></form></section>{{/escalated}}
</section>{{/detail}}{{/hasdetail}}
</div>
