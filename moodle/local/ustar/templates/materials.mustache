<div class="u-materials">

    <header class="u-materials-head">

        <div>
            <p class="u-pagehead__eyebrow">
                Центр управления
            </p>

            <h1>
                Материалы
            </h1>

            <p>
                Единый каталог документов, страниц, тестов,
                SCORM и других материалов.
            </p>
        </div>

        {{#canmanage}}

        <div class="u-materials-head__actions">

            <a
                class="u-btn"
                href="{{bulkurl}}"
            >
                Массовая загрузка
            </a>

            <details class="u-materials-folder-create">
                <summary class="u-btn">+ Папка</summary>
                <form method="post" class="u-materials-folder-create__form">
                    <input type="hidden" name="action" value="createfolder">
                    <input type="hidden" name="parent" value="{{currentparentid}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="text" name="foldertitle" maxlength="255" placeholder="Название папки" required>
                    <button class="u-btn u-btn--primary" type="submit">Создать</button>
                </form>
            </details>

            <a
                class="u-btn u-btn--primary u-materials-create-btn"
                href="{{createurl}}"
            >
                + Создать материал
            </a>

        </div>

        {{/canmanage}}


        <div class="u-materials-head__metric">
            <strong>{{total}}</strong>
            <span>в каталоге</span>
        </div>

    </header>


    <form
        class="u-materials-search"
        method="get"
        action=""
    >

        <input
            type="search"
            name="q"
            value="{{q}}"
            placeholder="Найти материал, регламент, тест..."
            autocomplete="off"
        >

        <input
            type="hidden"
            name="type"
            value="{{currenttype}}"
        >

        <input type="hidden" name="parent" value="{{currentparentid}}">


        <select name="status">

            {{#statusoptions}}
            <option
                value="{{id}}"
                {{#selected}}selected{{/selected}}
            >
                {{label}}
            </option>
            {{/statusoptions}}

        </select>

        <button
            class="u-btn"
            type="submit"
        >
            Найти
        </button>

    </form>


    <nav class="u-materials-types">

        {{#typefilters}}

        <a
            href="{{url}}"
            class="
                u-materials-type
                {{#selected}}is-active{{/selected}}
            "
        >
            <span>{{label}}</span>
            <strong>{{count}}</strong>
        </a>

        {{/typefilters}}

    </nav>

    <nav class="u-materials-breadcrumbs" aria-label="Путь к папке">
        <ol>
            <li>
                {{#hasparent}}<a href="?" data-u-drop-folder="0">Материалы</a>{{/hasparent}}
                {{^hasparent}}<span aria-current="page">Материалы</span>{{/hasparent}}
            </li>
            {{#breadcrumbs}}
            <li>
                {{#iscurrent}}<span aria-current="page">{{title}}</span>{{/iscurrent}}
                {{^iscurrent}}<a href="{{url}}" data-u-drop-folder="{{id}}">{{title}}</a>{{/iscurrent}}
            </li>
            {{/breadcrumbs}}
        </ol>
    </nav>


    <div class="u-materials-workspace">

        <section class="u-materials-catalog">

            <header class="u-materials-catalog__head">
                <div>
                    <span>Папка</span>
                    <strong>{{currentfolder}}</strong>
                </div>
                <div class="u-materials-catalog__count">
                    {{#hasparent}}<a class="u-btn u-btn--quiet" href="{{parenturl}}">← На уровень выше</a>{{/hasparent}}
                    <span>Объектов</span>
                    <strong>{{visiblecount}}</strong>
                </div>
            </header>


            {{#hasmaterials}}

            <div class="u-materials-list">

                {{#materials}}

                <div
                    class="u-material-row-shell u-material-row-shell--{{visualclass}} {{#isfolder}}u-material-row-shell--folder{{/isfolder}}"
                    data-u-drag-content="{{id}}"
                    data-u-expected-modified="{{timemodified}}"
                    {{#isfolder}}data-u-drop-folder="{{id}}"{{/isfolder}}
                    {{#canmove}}draggable="true"{{/canmove}}
                >

                <a
                    href="{{url}}"
                    class="
                        u-material-row
                        {{#selected}}is-selected{{/selected}}
                    "
                >

                    <div class="u-material-row__icon u-material-row__icon--{{visualclass}} {{#isfolder}}u-material-row__icon--folder{{/isfolder}}">
                        {{#isfolder}}
                        <span class="u-win-folder" aria-hidden="true">
                            <span class="u-win-folder__tab"></span>
                        </span>
                        {{/isfolder}}

                        {{^isfolder}}
                        <span class="u-win-file u-win-file--{{visualclass}}" aria-hidden="true">
                            <span class="u-win-file__fold"></span>
                            <strong>{{visualtype}}</strong>
                        </span>
                        {{/isfolder}}
                    </div>


                    <div class="u-material-row__body">

                        <div class="u-material-row__meta">

                            <span class="u-material-row__type">
                                {{visualtype}}
                            </span>

                            <span class="u-material-row__semantic">
                                {{visualcategory}}
                            </span>

                            <span>
                                {{statuslabel}}
                            </span>

                            {{#needsreview}}
                            <span class="u-material-flag">
                                Проверить
                            </span>
                            {{/needsreview}}

                        </div>


                        <strong class="u-material-row__title">
                            {{title}}
                        </strong>

                        {{#filename}}
                        <small class="u-material-row__filename">
                            {{filename}}
                        </small>
                        {{/filename}}


                        {{#ismoodle}}
                        <small>
                            {{coursename}}
                        </small>
                        {{/ismoodle}}


                        <div class="u-material-row__flags">

                            {{#duplicate}}
                            <span>
                                Возможный дубль
                            </span>
                            {{/duplicate}}

                            {{#coursehidden}}
                            <span>
                                Курс скрыт
                            </span>
                            {{/coursehidden}}

                            {{#activityhidden}}
                            <span>
                                Активность скрыта
                            </span>
                            {{/activityhidden}}

                        </div>

                    </div>

                </a>

                {{#canmove}}
                <details class="u-material-row-menu">
                    <summary aria-label="Действия с {{title}}">•••</summary>
                    <form method="post">
                        <input type="hidden" name="action" value="move">
                        <input type="hidden" name="contentid" value="{{id}}">
                        <input type="hidden" name="expectedmodified" value="{{timemodified}}">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <label>
                            <span>Переместить в</span>
                            <select name="targetparentid" required data-u-context-move-target>
                                <option value="" selected disabled>Выберите папку</option>
                                {{#folderoptions}}<option value="{{id}}">{{name}}</option>{{/folderoptions}}
                            </select>
                        </label>
                        <button class="u-btn u-btn--small" type="submit" disabled data-u-context-move-submit>Переместить</button>
                    </form>
                </details>
                {{/canmove}}

                </div>

                {{/materials}}

            </div>

            {{/hasmaterials}}


            {{^hasmaterials}}

            <div class="u-materials-empty" role="status">
                <span class="u-materials-empty__icon" aria-hidden="true">📂</span>
                {{#hasactivefilters}}
                <strong>Ничего не найдено</strong>
                <p>В этой папке нет объектов, соответствующих выбранным фильтрам.</p>
                <a class="u-btn" href="{{reseturl}}">Сбросить фильтры</a>
                {{/hasactivefilters}}
                {{^hasactivefilters}}
                <strong>Папка пока пуста</strong>
                <p>Здесь появятся созданные или перемещённые материалы и папки.</p>
                {{#canmanage}}<a class="u-btn u-btn--primary" href="{{createurl}}">Создать материал</a>{{/canmanage}}
                {{/hasactivefilters}}
            </div>

            {{/hasmaterials}}

        </section>


        

    </div>

</div>

{{#canmanage}}
<form method="post" class="u-materials-move-form" data-u-move-form hidden>
    <input type="hidden" name="action" value="move">
    <input type="hidden" name="contentid" value="">
    <input type="hidden" name="targetparentid" value="">
    <input type="hidden" name="expectedmodified" value="">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
</form>
<p class="sr-only" role="status" aria-live="polite" data-u-move-status></p>
{{/canmanage}}
