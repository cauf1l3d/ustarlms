<div class="u-product-page u-executive-page">

<header class="u-product-head u-exec-hero">
    <div>
        <p class="u-page-kicker">
            Высшее руководство · только чтение
        </p>

        <h1>Готовность компании</h1>

        <p>
            Люди, структура, квалификационные риски
            и состояние команд в одном управленческом срезе.
            Обновлено {{generated}}.
        </p>
    </div>

    {{{execicon}}}
</header>


<div class="u-stat-grid u-stat-grid--4">

    <article class="u-stat-card">
        <span>Активные сотрудники</span>
        <strong>{{totalPeople}}</strong>
        <small>рабочих аккаунтов</small>
    </article>

    <article class="u-stat-card">
        <span>Размечены по должностям</span>
        <strong>{{coverage}}%</strong>
        <small>{{assignedPeople}} сотрудников</small>
    </article>

    <article class="u-stat-card">
        <span>Квалификационно готовы</span>
        <strong>{{qualcoverage}}%</strong>
        <small>{{qualified}} без обязательных пробелов</small>
    </article>

    <article class="u-stat-card">
        <span>Требуют внимания</span>
        <strong>{{withgaps}}</strong>
        <small>есть обязательные skill gaps</small>
    </article>

</div>


<div class="u-exec-grid">

    <section class="u-panel">
        <header class="u-panel-title">
            <div>
                <p class="u-page-kicker">Структура</p>
                <h2>Численность по подразделениям</h2>
            </div>

            <span>{{totalPeople}}</span>
        </header>

        <div class="u-department-bars">
            {{#departments}}
            <div class="u-department-bar">
                <div>
                    <strong>{{name}}</strong>
                    <span>{{people}}</span>
                </div>

                <div class="u-progress">
                    <span style="width:{{width}}%"></span>
                </div>
            </div>
            {{/departments}}
        </div>
    </section>


    <aside class="u-panel u-exec-attention">
        <p class="u-page-kicker">
            Квалификационные риски
        </p>

        <strong class="u-exec-big">
            {{withgaps}}
        </strong>

        <p>
            сотрудников имеют незакрытые
            обязательные навыки.
        </p>

        {{#hastopgaps}}
        <div class="u-gap-list">
            {{#topgaps}}
            <div>
                <span>{{name}}</span>
                <b>{{count}}</b>
            </div>
            {{/topgaps}}
        </div>
        {{/hastopgaps}}
    </aside>

</div>


<section class="u-company-map">

    <header class="u-company-map__head">
        <div>
            <p class="u-page-kicker">Компания</p>
            <h2>Организационная иерархия</h2>

            {{#structuralmode}}
            <p>
                Карта построена по действующей штатной структуре:
                подразделениям, руководящим должностям
                и активным сотрудникам.
            </p>
            {{/structuralmode}}

            {{#exactreporting}}
            <p>
                Персональные линии подчинения подтверждены.
            </p>
            {{/exactreporting}}
        </div>

        {{#structuralmode}}
        <span class="u-exec-mode">
            По штатной структуре
        </span>
        {{/structuralmode}}
    </header>


    {{#hascompanydepartments}}
    <div class="u-company-departments">

        {{#companydepartments}}
        <details
            class="u-company-department"
            {{#hasheads}}open{{/hasheads}}
        >
            <summary>
                <div>
                    <strong>{{name}}</strong>
                    <small>{{people}} сотрудников</small>
                </div>

                <span>Открыть команду</span>
            </summary>


            {{#hasheads}}
            <div class="u-company-heads">
                <p class="u-page-kicker">
                    Руководство подразделения
                </p>

                <div class="u-company-person-grid">
                    {{#heads}}
                    <article class="u-company-person is-head">
                        <div class="u-company-avatar">
                            {{#avatarurl}}
                            <img src="{{avatarurl}}" alt="">
                            {{/avatarurl}}
                        </div>

                        <div>
                            <strong>{{fullname}}</strong>
                            <span>{{position}}</span>
                        </div>
                    </article>
                    {{/heads}}
                </div>
            </div>
            {{/hasheads}}


            {{^hasheads}}
            <div class="u-company-head-missing">
                Руководящая штатная позиция
                сейчас не занята или не размечена.
            </div>
            {{/hasheads}}


            {{#hasgroups}}
            <div class="u-company-position-groups">

                {{#groups}}
                <section class="u-company-position-group">
                    <header>
                        <strong>{{name}}</strong>
                        <span>{{count}}</span>
                    </header>

                    <div class="u-company-person-grid">
                        {{#people}}
                        <article class="u-company-person">
                            <div class="u-company-avatar">
                                {{#avatarurl}}
                                <img src="{{avatarurl}}" alt="">
                                {{/avatarurl}}
                            </div>

                            <div>
                                <strong>{{fullname}}</strong>
                                <span>{{position}}</span>
                            </div>
                        </article>
                        {{/people}}
                    </div>
                </section>
                {{/groups}}

            </div>
            {{/hasgroups}}

        </details>
        {{/companydepartments}}

    </div>
    {{/hascompanydepartments}}

</section>


<div class="u-stat-grid u-stat-grid--3">

    <article class="u-stat-card">
        <span>Активность обучения</span>
        <strong>{{activeLearners30}}</strong>
        <small>сотрудников за 30 дней</small>
    </article>

    <article class="u-stat-card">
        <span>Legacy-завершения</span>
        <strong>{{completedCourses30}}</strong>
        <small>сохранено для переходного периода</small>
    </article>

    <article class="u-stat-card">
        <span>Без должности</span>
        <strong>{{unassignedPeople}}</strong>
        <small>требуют штатной разметки</small>
    </article>

</div>

</div>
