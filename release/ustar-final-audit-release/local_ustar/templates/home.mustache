{{#viewcareer}}

{{#development}}

<div class="u-pagehead u-development-head">

    <div>

        <p class="u-pagehead__eyebrow">
            Развитие
        </p>

        <h1>
            Мой профиль развития
        </h1>

        <p class="u-pagehead__sub">
            Требования роли, учебное покрытие
            и карьерный маршрут.
        </p>

    </div>

</div>

<div class="u-development-tools">
    <a class="u-feature-card" href="{{profileurl}}">{{{profileicon}}}<div><strong>Личный кабинет</strong><span>Весь личный прогресс</span></div><b>→</b></a>
    <a class="u-feature-card" href="{{gamesurl}}">{{{gameicon}}}<div><strong>Игровые задания</strong><span>Микрообучение и XP</span></div><b>→</b></a>
    <a class="u-feature-card" href="{{achievementsurl}}">{{{trophyicon}}}<div><strong>Достижения</strong><span>Уровни и награды</span></div><b>→</b></a>
    <a class="u-feature-card" href="{{checklistsurl}}">{{{checkicon}}}<div><strong>Чек-листы</strong><span>Рабочие evidence</span></div><b>→</b></a>
    {{#hasdevelopmentassessment}}<a class="u-feature-card" href="{{developmentassessmenturl}}">{{{sparkicon}}}<div><strong>Мой развивающий профиль</strong><span>Саморефлексия и рекомендации</span></div><b>→</b></a>{{/hasdevelopmentassessment}}
    {{#hasteam}}<a class="u-feature-card" href="{{teamurl}}">{{{teamicon}}}<div><strong>Моя команда</strong><span>Прогресс руководителя</span></div><b>→</b></a>{{/hasteam}}
    {{#hasdevelopmentanalytics}}<a class="u-feature-card" href="{{developmentanalyticsurl}}">{{{profileicon}}}<div><strong>Развитие команды</strong><span>Защищённая аналитика HRD</span></div><b>→</b></a>{{/hasdevelopmentanalytics}}
    {{#hasexecutive}}<a class="u-feature-card" href="{{executiveurl}}">{{{executiveicon}}}<div><strong>Руководство</strong><span>Готовность компании</span></div><b>→</b></a>{{/hasexecutive}}
</div>


{{#hasposition}}

<section class="u-role-card">

    <div class="u-role-card__identity">

        <p class="u-role-card__eyebrow">
            Текущая роль
        </p>

        <h2>
            {{positionname}}
        </h2>

        {{#hasdepartment}}
        <p class="u-role-card__department">
            {{departmentname}}
        </p>
        {{/hasdepartment}}

    </div>


    <div class="u-role-card__meta">

        <div>

            <span>
                Ступень
            </span>

            <strong>
                {{positionlevel}}
            </strong>

        </div>


        <div>

            <span>
                Требований
            </span>

            <strong>
                {{skillcount}}
            </strong>

        </div>


        <div>

            <span>
                Обучение связано
            </span>

            <strong>
                {{configuredskillcount}} / {{skillcount}}
            </strong>

        </div>

    </div>

</section>



{{#haslearningcoverage}}

<section class="u-development-coverage">

    <div>

        <p class="u-development-coverage__eyebrow">
            Покрытие обучения
        </p>

        <h2>
            {{learningcoverage}}%
        </h2>

        <p>
            По тем требованиям роли, для которых
            уже настроено и назначено обучение.
        </p>

    </div>

    <div
        class="u-development-ring"
        style="--u-value: {{learningcoverage}}"
        aria-label="Покрытие обучения {{learningcoverage}}%"
    >
        <span>
            {{learningcoverage}}
        </span>
    </div>

</section>

{{/haslearningcoverage}}



{{^haslearningcoverage}}

<section class="u-development-note">

    <div class="u-development-note__icon">
        !
    </div>

    <div>

        <strong>
            Навыки роли уже определены
        </strong>

        <p>
            Но связанное обучение ещё не полностью
            настроено в Moodle. Поэтому мы не показываем
            искусственную оценку готовности.
        </p>

    </div>

</section>

{{/haslearningcoverage}}



{{#hasskills}}

<section class="u-development-section">

    <header class="u-sectionhead">

        <div>

            <p class="u-sectionhead__eyebrow">
                Требования роли
            </p>

            <h2>
                Ключевые навыки
            </h2>

        </div>

        <span>
            {{skillcount}}
        </span>

    </header>


    <div class="u-development-skills">

        {{#skills}}

        <article
            class="u-skill-card
                   u-skill-card--{{statecode}}"
        >

            <div class="u-skill-card__head">

                <div>

                    {{#hascategory}}

                    <p class="u-skill-card__category">
                        {{category}}
                    </p>

                    {{/hascategory}}

                    <h3>
                        {{name}}
                    </h3>

                </div>

                <span class="u-skill-level">
                    {{requiredlabel}}
                </span>

            </div>


            {{#evidenceconfigured}}

            <div class="u-skill-evidence">

                <div class="u-skill-evidence__summary">

                    <span>
                        Подтверждение
                    </span>

                    <strong>
                        {{evidenceprogress}}%
                    </strong>

                </div>


                {{#evidenceitems}}

                <div
                    class="
                        u-evidence-row
                        {{#satisfied}}is-done{{/satisfied}}
                        {{#failed}}is-failed{{/failed}}
                    "
                >

                    <div class="u-evidence-row__marker">

                        {{#satisfied}}
                        ✓
                        {{/satisfied}}

                        {{^satisfied}}
                        {{#failed}}
                        !
                        {{/failed}}

                        {{^failed}}
                        ·
                        {{/failed}}
                        {{/satisfied}}

                    </div>


                    <div class="u-evidence-row__body">

                        <div class="u-evidence-row__top">

                            <strong>
                                {{typelabel}}
                            </strong>

                            <span>
                                {{statuslabel}}
                            </span>

                        </div>


                        {{#hasactivity}}

                        <p>
                            {{activityname}}
                        </p>

                        {{/hasactivity}}


                        {{#hasvalidity}}

                        <small>
                            Период подтверждения:
                            {{validdays}} дн.
                        </small>

                        {{/hasvalidity}}

                    </div>

                </div>

                {{/evidenceitems}}

            </div>

            {{/evidenceconfigured}}


            {{^evidenceconfigured}}

            <div class="u-skill-evidence-empty">

                <span></span>

                <p>
                    Подтверждение навыка
                    пока не настроено
                </p>

            </div>

            {{/evidenceconfigured}}


            {{#measurable}}

            <div class="u-skill-measure">

                <div class="u-skill-measure__levels">

                    <span>
                        Учебное покрытие
                    </span>

                    <strong>
                        {{currentlearninglevel}}
                        /
                        {{requiredlevel}}
                    </strong>

                </div>

                <div
                    class="u-progressbar"
                    role="progressbar"
                    aria-valuemin="0"
                    aria-valuemax="100"
                    aria-valuenow="{{learningprogress}}"
                >
                    <span
                        style="width: {{learningprogress}}%"
                    ></span>
                </div>

                <div class="u-skill-measure__percent">
                    {{learningprogress}}%
                </div>

            </div>

            {{/measurable}}


            {{^measurable}}

            <div class="u-skill-unmeasured">

                <span class="u-skill-unmeasured__dot"></span>

                <p>
                    {{state}}
                </p>

            </div>

            {{/measurable}}

        </article>

        {{/skills}}

    </div>

</section>

{{/hasskills}}



{{#hascareer}}

<section class="u-development-section">

    <header class="u-sectionhead">

        <div>

            <p class="u-sectionhead__eyebrow">
                Карьера
            </p>

            <h2>
                Мой маршрут
            </h2>

        </div>

    </header>


    <div class="u-career-track">

        {{#careersteps}}

        <div
            class="u-career-step
                   {{#ispast}}is-past{{/ispast}}
                   {{#iscurrent}}is-current{{/iscurrent}}
                   {{#isfuture}}is-future{{/isfuture}}"
        >

            <div class="u-career-step__marker">

                {{#ispast}}
                    ✓
                {{/ispast}}

                {{#iscurrent}}
                    {{level}}
                {{/iscurrent}}

                {{#isfuture}}
                    {{level}}
                {{/isfuture}}

            </div>

            <div class="u-career-step__body">

                {{#iscurrent}}
                <span>
                    Вы здесь
                </span>
                {{/iscurrent}}

                {{#ispast}}
                <span>
                    Пройденная ступень
                </span>
                {{/ispast}}

                {{#isfuture}}
                <span>
                    Следующая ступень
                </span>
                {{/isfuture}}

                <strong>
                    {{name}}
                </strong>

            </div>

        </div>

        {{#connector}}

        <div
            class="u-career-connector"
            aria-hidden="true"
        ></div>

        {{/connector}}

        {{/careersteps}}

    </div>


    {{#hasnextposition}}

    <div class="u-career-next">

        <p>
            Следующая роль
        </p>

        <strong>
            {{nextpositionname}}
        </strong>

    </div>

    {{/hasnextposition}}


    {{#istopposition}}

    <div class="u-career-top">

        <span aria-hidden="true">
            ◆
        </span>

