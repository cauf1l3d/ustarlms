<div class="u-route2-page">
    <header class="u-route2-hero">
        <div>
            <p class="u-page-kicker">Мой маршрут развития</p>
            {{#hasroute}}<h1>{{route.name}}</h1>{{/hasroute}}
            {{^hasroute}}<h1>Учебный маршрут</h1>{{/hasroute}}
            <p>Один последовательный маршрут для вашей должности. Обновления добавляются в него без потери уже пройденной истории.</p>
        </div>

        <div class="u-route2-hero__actions">
            <a class="u-btn" href="{{homeurl}}">← На главную</a>
            {{#iselevated}}{{#hasposition}}
            <a class="u-btn u-btn--primary" href="{{studio}}">Редактор маршрута</a>
            {{/hasposition}}{{/iselevated}}
        </div>
    </header>

    {{#iselevated}}
    <form class="u-route2-preview" method="get">
        <label>
            <span>Просмотр как сотрудник должности</span>
            <select name="position" onchange="this.form.submit()">
                {{#positions}}
                <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                {{/positions}}
            </select>
        </label>
        <noscript><button class="u-btn" type="submit">Открыть</button></noscript>
    </form>
    {{/iselevated}}


    {{#hasadaptation}}{{#adaptation}}
    <section class="u-adaptation-route-card {{#blocked}}is-blocked{{/blocked}}">
        <div>
            <p class="u-page-kicker">Моя адаптация</p><h2>Адаптационный лист · день {{daynumber}} из {{plannedworkdays}}</h2>
            <p>{{statuslabel}} · начало {{startdate}} · рабочая дата {{workdate}}</p>
            <div class="u-adaptation-route-status"><span>Мой лист: <b>{{employeestatus}}</b></span><span>Руководитель: <b>{{managerstatus}}</b></span></div>
            {{#blocked}}<p class="u-adaptation-route-alert">Просрочен ваш лист за {{overduedate}}. Дальнейшее продвижение по обучению приостановлено до заполнения.</p>{{/blocked}}
            {{#awaitingfinal}}<div class="u-adaptation-route-status"><span>Мой итог: <b>{{employeefinalstatus}}</b></span><span>Итог руководителя: <b>{{managerfinalstatus}}</b></span></div>{{/awaitingfinal}}
            {{#awaitingfinal}}<p class="u-adaptation-route-note">Ежедневные листы завершены. Обе стороны независимо заполняют итоговые отчёты.</p>{{/awaitingfinal}}
            {{#escalated}}<p class="u-adaptation-route-alert">Итог адаптации передан HRD. Ожидается решение HRD.</p>{{/escalated}}
        </div>
        {{#canfill}}<a class="u-btn u-btn--primary u-btn--large" href="{{formurl}}">Заполнить адаптационный лист</a>{{/canfill}}
        {{#canfinalfill}}<a class="u-btn u-btn--primary u-btn--large" href="{{finalformurl}}">Заполнить итоговый отчёт</a>{{/canfinalfill}}
    </section>
    {{/adaptation}}{{/hasadaptation}}

    {{#hasroute}}
    {{#route}}

    <section class="u-route2-metrics">
        <article>
            <span>Прогресс</span>
            <strong>{{progress}}%</strong>
            <small>{{donepoints}} из {{totalpoints}} актуальных шагов</small>
        </article>

        <article>
            <span>Пройдено</span>
            <strong>{{donepoints}}</strong>
            <small>История завершений сохраняется</small>
        </article>

        <article>
            <span>Осталось</span>
            <strong>{{remaining}}</strong>
            <small>Маршрут продолжает обновляться</small>
        </article>

        <article>
            <span>Статус</span>
            {{#sequencecomplete}}
            <strong class="is-ok">Всё актуально</strong>
            <small>Новых обязательных шагов сейчас нет</small>
            {{/sequencecomplete}}
            {{#sequencerunning}}
            <strong>В процессе</strong>
            <small>Доступен следующий шаг</small>
            {{/sequencerunning}}
        </article>
    </section>

    {{#hascurrentpoint}}
    {{#currentpoint}}
    <section class="u-route2-now {{#assessmentremediation}}is-remediation{{/assessmentremediation}}{{#assessmentawaiting}} is-awaiting{{/assessmentawaiting}}{{#assessmentexhausted}} is-exhausted{{/assessmentexhausted}}">
        <div class="u-route2-now__body">
            <p class="u-page-kicker">Следующий шаг</p>
            <h2>{{title}}</h2>
            <p>Шаг {{number}} · {{versionlabel}}</p>

            {{#assessmentawaiting}}
            <div class="u-assess-state is-awaiting">
                <strong>Результат ожидает проверки</strong>
                <span>Использовано попыток: {{assessmentattemptsused}} из {{assessmentattemptlimit}}. Следующая попытка откроется после итоговой ручной оценки.</span>
            </div>
            {{/assessmentawaiting}}

            {{#assessmentremediation}}
            <div class="u-assess-state is-remediation">
                <strong>Обязательное переобучение</strong>
                <span>Использовано попыток: {{assessmentattemptsused}} из {{assessmentattemptlimit}} · лучший результат {{assessmentbestscore}} / {{assessmentmaxscore}} · проходной {{assessmentpassscore}}.</span>
                <span>Повторите «{{remediationtitle}}». После нового подтверждённого прохождения откроются попытки {{nextattemptstart}}–{{nextattemptend}}.</span>
            </div>
            {{/assessmentremediation}}

            {{#assessmentreopened}}
            <div class="u-assess-state is-reopened">
                <strong>Переобучение завершено</strong>
                <span>Дополнительный пакет попыток открыт. Текущий лимит: {{assessmentattemptlimit}}.</span>
            </div>
            {{/assessmentreopened}}

            {{#assessmentmanagerreview}}
<div class="u-route-assessment u-route-assessment--warning">
    <strong>Ожидается решение руководителя</strong>
    <span>Использовано {{assessmentattemptsused}} / {{assessmentattemptlimitlabel}} попыток · лучший результат {{assessmentbestscore}} / {{assessmentmaxscore}} · проходной {{assessmentpassscore}}. Переобучение и дополнительные попытки откроются только после решения руководителя.</span>
</div>
{{/assessmentmanagerreview}}
{{#assessmenthrdreview}}
            <div class="u-assess-state is-exhausted">
                <strong>Ожидается решение HRD</strong>
                <span>Использованы два пакета попыток. Руководитель видит результат, но следующий цикл может открыть только HRD.</span>
            </div>
            {{/assessmenthrdreview}}

{{#assessmentexhausted}}
            <div class="u-assess-state is-exhausted">
                <strong>Доступные циклы аттестации исчерпаны</strong>
                <span>Лучший результат {{assessmentbestscore}} / {{assessmentmaxscore}} при проходном {{assessmentpassscore}}. Состояние передано в HRD.</span>
            </div>
            {{/assessmentexhausted}}
        </div>

        {{#canlaunch}}
        <a class="u-btn u-btn--primary u-btn--large" href="{{launchurl}}">{{actionlabelshort}}</a>
        {{/canlaunch}}
    </section>
    {{/currentpoint}}
    {{/hascurrentpoint}}

    <section class="u-panel">
        <header class="u-panel-title">
            <div>
                <p class="u-page-kicker">Постоянный маршрут</p>
                <h2>Ваш путь в USTAR</h2>
                <p>Показываются только шаги, относящиеся к вашей должности.</p>
            </div>
            <span>{{donepoints}} / {{totalpoints}}</span>
        </header>

        <div class="u-route2-list">
            {{#points}}
            <article class="u-route2-point is-{{status}}">
                <div class="u-route2-point__marker">
                    {{#done}}✓{{/done}}
                    {{^done}}{{number}}{{/done}}
                </div>

                <div class="u-route2-point__body">
                    <div class="u-route2-point__head">
                        <div>
                            <span>Шаг {{number}} · {{versionlabel}}</span>
                            <h3>{{title}}</h3>
                        </div>
                        <b>{{statuslabel}}</b>
                    </div>

                    {{#hassummary}}<p>{{summary}}</p>{{/hassummary}}

                    {{#inherited}}
                    <small class="u-route2-inherited">Результат сохранён с предыдущей версии</small>
                    {{/inherited}}

                    {{#assessmenthasstats}}
                    <div class="u-route2-assess-summary">
                        <span>Попытки <strong>{{assessmentattemptsused}} / {{assessmentattemptlimitlabel}}</strong></span>
                        <span>Лучший результат <strong>{{assessmentbestscore}} / {{assessmentmaxscore}}</strong></span>
                        <span>Проходной <strong>{{assessmentpassscore}}</strong></span>
                    </div>
                    {{/assessmenthasstats}}

                    {{#requirements}}
                    <div class="u-route2-req {{#satisfied}}is-ok{{/satisfied}}{{#failed}}is-fail{{/failed}}">
                        <span>{{label}}</span>
                        <small>{{detail}}</small>
                    </div>
                    {{/requirements}}

                    {{#hasdevelopedskills}}
                    <div class="u-route2-skills">
                        <strong>Развивает:</strong>
                        {{#developedskills}}<span>{{label}}</span>{{/developedskills}}
                    </div>
                    {{/hasdevelopedskills}}

                    {{#canlaunch}}
                    <a class="u-route2-link" href="{{launchurl}}">{{actionlabel}}</a>
                    {{/canlaunch}}
                </div>
            </article>
            {{/points}}
        </div>
    </section>

    {{/route}}
    {{/hasroute}}

    {{#noroute}}
    <section class="u-empty-state u-route2-empty">
        {{#hasposition}}
        <h2>Для должности пока не настроен маршрут</h2>
        <p>HR может настроить постоянный маршрут семьи и применимость шагов.</p>
        {{/hasposition}}

        {{^hasposition}}
        <h2>У пользователя не определена должность</h2>
        <p>Назначьте USTAR-должность, чтобы система могла определить маршрут.</p>
        {{/hasposition}}

        <a class="u-btn" href="{{homeurl}}">← На главную</a>
    </section>
    {{/noroute}}
</div>
