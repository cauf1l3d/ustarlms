<section class="u-library__section"><h2>Мои материалы <span class="u-muted">{{materialcount}}</span></h2>
{{#hasmaterials}}<div class="u-library__grid">{{#materials}}<article class="u-lcard"><div class="u-lcard__body"><p class="u-lcard__meta">{{typelabel}} · {{date}}</p><h3 class="u-lcard__title">{{title}}</h3><p class="u-lcard__summary">{{summary}}</p></div><div class="u-lcard__foot">
{{#writable}}<form method="post" action="{{libraryurl}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="launch">{{#offerid}}<input type="hidden" name="offerid" value="{{offerid}}">{{/offerid}}{{#contentid}}<input type="hidden" name="contentid" value="{{contentid}}">{{/contentid}}<button class="u-btn u-btn--secondary" type="submit">Открыть</button></form>{{/writable}}
{{^writable}}<a class="u-btn" href="{{url}}">Посмотреть</a>{{/writable}}</div></article>{{/materials}}</div>{{/hasmaterials}}
{{^hasmaterials}}<div class="u-empty"><h3>Здесь будут ваши материалы</h3><p>Назначенные, открытые за USCOIN и изученные в маршруте. {{#canmarketplace}}Дополнительные знания доступны в Маркетплейсе.{{/canmarketplace}}</p></div>{{/hasmaterials}}
</section>
{{#hassavedfiles}}<section class="u-library__section"><h2>Сохранено из ленты</h2><ul class="u-library__checks">{{#savedfiles}}<li class="u-checkrow"><div><strong>{{title}}</strong><span class="u-muted">{{date}} · {{size}}</span></div><a class="u-btn" href="{{url}}">Скачать</a>{{#writable}}<form method="post" action="{{libraryurl}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="removefeedfile"><input type="hidden" name="savedid" value="{{id}}"><button type="submit" class="u-btn">Убрать из сохранённого</button></form>{{/writable}}</li>{{/savedfiles}}</ul></section>{{/hassavedfiles}}
