[Unit]
Description=USTAR fixed read-only host probes
After=network.target

[Service]
Type=oneshot
User=root
Group=ustar-console
UMask=0027
RuntimeDirectory=ustar-console-data
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=ustar-console-collector
StateDirectoryMode=0700
ExecStart=/opt/ustar-console/venv/bin/ustar-console-collect
TimeoutStartSec=12
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/ustar-console-data /var/lib/ustar-console-collector
Nice=10
MemoryMax=192M
CPUQuota=25%
TasksMax=32
LimitNOFILE=128
StandardOutput=journal
StandardError=journal
