<div class="u-product-page u-route-studio u-route-editor">
  <header class="u-route-editor__head">
    <div><p class="u-page-kicker">Учебный маршрут</p><h1>Конструктор маршрутов</h1><p>Настраивайте общий маршрут семьи и отличия конкретных должностей. Общие шаги наследуются автоматически, а должностные изменения сохраняются отдельно.</p></div>
    {{#canpreview}}<a class="u-btn" href="{{previewurl}}">Посмотреть как сотрудник</a>{{/canpreview}}
  </header>

  {{#saved}}<div class="u-inline-notice u-inline-notice--success"><strong>Изменения сохранены</strong><span>Опубликованные версии и уже пройденное обучение остались в истории.</span></div>{{/saved}}

  <form class="u-route-editor__position" method="get">
    <label><span>Семья маршрутов</span><select name="family" aria-label="Выберите семью маршрутов" onchange="this.form.submit()">{{#familyoptions}}<option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>{{/familyoptions}}</select></label>
    {{^familyselected}}<label><span>Должность</span><select name="position" aria-label="Выберите должность" onchange="this.form.submit()">{{#positions}}<option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>{{/positions}}</select></label>{{/familyselected}}
    <noscript><button class="u-btn" type="submit">Открыть</button></noscript>
    <a href="{{materialsurl}}" class="u-btn">Открыть материалы</a>
  </form>

  {{#familyselected}}
  <nav class="u-route-family-tabs" aria-label="Маршруты семьи {{familyname}}">
    {{#familytabs}}<a href="{{url}}" class="u-route-family-tab {{#selected}}is-active{{/selected}}">{{label}}</a>{{/familytabs}}
  </nav>
  {{/familyselected}}

  {{#noroute}}
  <section class="u-panel u-route-editor__empty"><h2>Для этой должности маршрут ещё не создан</h2><p>Можно начать с чистого маршрута или перенести текущие обязательные Moodle-курсы как первые версии точек. Старые данные не удаляются.</p><form method="post"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="family" value="{{familyid}}"><input type="hidden" name="view" value="{{viewmode}}"><input type="hidden" name="position" value="{{positionid}}"><input type="hidden" name="action" value="ensure"><button class="u-btn u-btn--primary" type="submit">Создать маршрут из текущего обучения</button></form></section>
  {{/noroute}}

  {{#routeexists}}{{#route}}
  {{#attached}}<p class="u-route-editor__notice" role="status">Файл опубликован в USTAR Content и автоматически добавлен в новую опубликованную версию точки.</p>{{/attached}}
  <section class="u-route-editor__overview"><div><p class="u-page-kicker">{{routekicker}}</p><h2>{{name}}</h2><p>{{pointcount}} шагов. {{routedescription}}</p></div><span class="u-route-editor__badge">{{routebadge}}</span></section>

  {{#haspoints}}
  <form id="u-route-order" method="post"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="family" value="{{familyid}}"><input type="hidden" name="view" value="{{viewmode}}"><input type="hidden" name="position" value="{{positionid}}"><input type="hidden" name="action" value="reorder"><input type="hidden" name="revision" value="{{revision}}"></form>
  <section class="u-route-editor__canvas" aria-label="Шаги маршрута"><div class="u-route-editor__canvas-head"><div><h2>Маршрут сейчас</h2><p>{{#canreorder}}Перетаскивайте шаги или пользуйтесь стрелками.{{/canreorder}}{{^canreorder}}Порядок общих шагов задаётся в Общем маршруте. Для локального изменения сначала создайте переопределение.{{/canreorder}}</p></div>{{#canreorder}}<button class="u-btn" form="u-route-order" type="submit">Сохранить порядок</button>{{/canreorder}}</div>
    <div id="u-route-list" class="u-route-editor__list">
    {{#points}}
      <article id="point-{{id}}" class="u-route-editor__point {{#editing}}is-editing{{/editing}} {{#isinherited}}is-inherited{{/isinherited}} {{#isoverride}}is-override{{/isoverride}}" draggable="{{draggable}}" data-u-draggable="{{draggableflag}}" tabindex="0">
        <input form="u-route-order" type="hidden" name="pointids[]" value="{{id}}">
        <div class="u-route-editor__point-order"><span class="u-route-item__order">{{sortorder}}</span><span class="u-route-editor__line"></span></div>
        <div class="u-route-editor__point-main"><div class="u-route-editor__point-meta"><span class="u-route-editor__inheritance">{{inheritancelabel}}</span>{{#hasscopeproposal}}<span class="u-route-editor__inheritance">{{scopeproposal}}</span>{{/hasscopeproposal}}{{#latest}}<span>{{versionlabel}}</span><span>{{#published}}Опубликовано{{/published}}{{#draft}}Черновик{{/draft}}{{#archived}}Архив{{/archived}}</span>{{/latest}}</div><h3>{{#latest}}{{title}}{{/latest}}</h3>{{#latest}}{{#hassummary}}<p>{{summary}}</p>{{/hassummary}}{{/latest}}
          {{#latest}}{{#hasrequirements}}<div class="u-route-editor__chips">{{#requirements}}<span>{{label}}</span>{{/requirements}}</div>{{/hasrequirements}}{{/latest}}
          {{^latest}}<p class="u-route-editor__muted">У точки ещё нет версии с учебным содержанием.</p>{{/latest}}
          <div class="u-route-editor__actions">
            {{#canedit}}<a class="u-btn u-btn--small" href="{{editurl}}#point-{{id}}">Редактировать</a>{{/canedit}}
            {{#canoverride}}<form method="post" class="u-route-editor__inline-action"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="family" value="{{familyid}}"><input type="hidden" name="view" value="{{viewmode}}"><input type="hidden" name="position" value="{{positionid}}"><input type="hidden" name="action" value="make_override"><input type="hidden" name="pointid" value="{{id}}"><button class="u-btn u-btn--small" type="submit">Изменить для этой должности</button></form>{{/canoverride}}
            {{#canrevert}}<form method="post" class="u-route-editor__inline-action"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="family" value="{{familyid}}"><input type="hidden" name="view" value="{{viewmode}}"><input type="hidden" name="position" value="{{positionid}}"><input type="hidden" name="action" value="revert_parent"><input type="hidden" name="pointid" value="{{id}}"><button class="u-btn u-btn--small" type="submit">Вернуть общий вариант</button></form>{{/canrevert}}
            {{#canmove}}<button type="button" class="u-btn u-btn--small" data-u-move="up" aria-label="Поднять шаг">↑</button><button type="button" class="u-btn u-btn--small" data-u-move="down" aria-label="Опустить шаг">↓</button>{{/canmove}}
          </div>
        </div>
        {{#editing}}
        <div class="u-route-editor__edit"><div class="u-route-editor__edit-head"><div><h3>Новая версия шага</h3><p>Старую опубликованную версию не меняем: сохраняем новое содержание отдельной версией.</p></div></div>
          <form method="post" class="u-route-editor__form"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="family" value="{{familyid}}"><input type="hidden" name="view" value="{{viewmode}}"><input type="hidden" name="position" value="{{positionid}}"><input type="hidden" name="action" value="save_version"><input type="hidden" name="pointid" value="{{id}}"><input type="hidden" name="expectedmodified" value="{{expectedmodified}}">
            <div class="u-route-editor__grid"><label><span>Название</span><input name="title" value="{{formtitle}}" required></label><input type="hidden" name="phase" value="{{phase}}"><label class="u-route-editor__wide"><span>Описание</span><textarea name="summary" rows="3" placeholder="Что сотрудник должен сделать и зачем">{{formsummary}}</textarea></label></div>
            <fieldset><legend>Обучение</legend><p>Выберите уже созданные материалы, курс, активность или развивающий профиль. В интерфейсе сотрудника будут видны только понятные названия.</p><label><span>Материалы, файлы и видео</span><select name="contentids[]" multiple size="5">{{#contentoptions}}<option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}} — {{meta}}</option>{{/contentoptions}}</select></label>{{#canupload}}<a href="{{uploadurl}}" class="u-route-editor__link">Загрузить файл или видео и сразу добавить в этот шаг</a>{{/canupload}}<div class="u-route-editor__grid"><label><span>Moodle-курс</span><select name="courseid"><option value="0">Не добавлять курс</option>{{#courseoptions}}<option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>{{/courseoptions}}</select></label><label><span>Учебная активность или тест</span><select name="cmid"><option value="0">Не добавлять активность</option>{{#activityoptions}}<option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>{{/activityoptions}}</select></label><label><span>Развивающий профиль</span><select name="assessmentkey"><option value="">Не добавлять профиль</option>{{#assessmentoptions}}<option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}} — {{meta}}</option>{{/assessmentoptions}}</select></label></div></fieldset>
            <fieldset><legend>Навыки</legend><p>Выберите навыки, которые развивает это обучение. Они используются в матрице должности, профиле сотрудника и аналитике руководителя, но сами по себе не блокируют завершение точки. «Главный навык» — основной результат этого обучения.</p><div class="u-route-editor__grid"><label><span>Какие навыки развивает эта точка</span><select name="skillids[]" multiple size="5">{{#skilloptions}}<option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>{{/skilloptions}}</select></label><label><span>Главный навык точки</span><select name="primaryskillid"><option value="">Не указан</option>{{#primaryskills}}<option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>{{/primaryskills}}</select></label></div></fieldset>
            <fieldset><legend>Завершение и публикация</legend><div class="u-route-editor__grid"><label><span>Как учитывать материал</span><select name="completionmode"><option value="open" {{#openselected}}selected{{/openselected}}>После открытия из маршрута</option><option value="ack" {{#ackselected}}selected{{/ackselected}}>После подтверждения ознакомления</option></select></label><label><span>Повторное прохождение</span><select name="renewalpolicy"><option value="keep" {{#keepselected}}selected{{/keepselected}}>Сохранить прошлый результат</option><option value="all" {{#allselected}}selected{{/allselected}}>Отправить всех на повторное прохождение</option><option value="expiry" {{#expiryselected}}selected{{/expiryselected}}>Повторять после срока действия</option><option value="manual" {{#manualselected}}selected{{/manualselected}}>Назначать повтор вручную</option></select></label><label><span>Срок действия, дней</span><input type="number" min="0" max="3650" name="validdays" value="{{formvaliddays}}"></label><label><span>Статус</span><select name="status"><option value="draft" {{#draftselected}}selected{{/draftselected}}>Черновик</option><option value="published" {{#publishedselected}}selected{{/publishedselected}}>Опубликовать для сотрудников</option></select></label></div><label class="u-route-editor__check"><input type="checkbox" name="required" value="1" checked> Обязательно для завершения точки</label><label class="u-route-editor__check"><input type="checkbox" name="previousadaptation" value="1" {{previouschecked}}> Сначала завершить предыдущие обязательные шаги</label><label class="u-route-editor__check"><input type="checkbox" name="active" value="1" {{activechecked}}> Шаг активен в маршруте</label></fieldset>
            <div class="u-route-editor__save"><button class="u-btn u-btn--primary" type="submit">Сохранить как новую версию</button><a class="u-btn" href="{{cancelurl}}">Отмена</a></div>
          </form>
        </div>
        {{/editing}}
      </article>
    {{/points}}
    </div>
  </section>
  {{/haspoints}}

  {{#caneditroute}}
<section class="u-route-editor__add"><header><p class="u-page-kicker">{{addkicker}}</p><h2>{{addtitle}}</h2><p>{{#isparent}}Новый общий шаг автоматически появится во всех должностных маршрутах семьи.{{/isparent}}{{^isparent}}Этот шаг относится только к выбранной должности и не изменяет общий маршрут семьи.{{/isparent}}</p></header>
    <form method="post" class="u-route-editor__form"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="family" value="{{familyid}}"><input type="hidden" name="view" value="{{viewmode}}"><input type="hidden" name="position" value="{{positionid}}"><input type="hidden" name="action" value="add_point"><div class="u-route-editor__grid"><label><span>Название</span><input name="title" required placeholder="Например: Работа с ассортиментом"></label><input type="hidden" name="phase" value="adaptation"><label class="u-route-editor__wide"><span>Описание</span><textarea name="summary" rows="3" placeholder="Что сотрудник получит от этой точки"></textarea></label></div>
      <fieldset><legend>Добавить обучение</legend><label><span>Материалы, файлы и видео</span><select name="contentids[]" multiple size="5">{{#addcontentoptions}}<option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}} — {{meta}}</option>{{/addcontentoptions}}</select></label><p class="u-route-editor__muted">Чтобы загрузить новый файл с автоматической привязкой, сначала создайте эту точку, затем откройте её для редактирования.</p><div class="u-route-editor__grid"><label><span>Moodle-курс</span><select name="courseid"><option value="0">Не добавлять курс</option>{{#courseoptions}}<option value="{{id}}">{{name}}</option>{{/courseoptions}}</select></label><label><span>Учебная активность или тест</span><select name="cmid"><option value="0">Не добавлять активность</option>{{#activityoptions}}<option value="{{id}}">{{name}}</option>{{/activityoptions}}</select></label><label><span>Развивающий профиль</span><select name="assessmentkey"><option value="">Не добавлять профиль</option>{{#assessmentoptions}}<option value="{{id}}">{{name}} — {{meta}}</option>{{/assessmentoptions}}</select></label></div></fieldset>
      <fieldset><legend>Навыки и правила</legend><div class="u-route-editor__grid"><label><span>Какие навыки развивает эта точка</span><select name="skillids[]" multiple size="5">{{#skilloptions}}<option value="{{id}}">{{name}}</option>{{/skilloptions}}</select></label><label><span>Главный навык точки</span><select name="primaryskillid"><option value="">Не указан</option>{{#primaryskills}}<option value="{{id}}">{{name}}</option>{{/primaryskills}}</select></label><label><span>Как учитывать материал</span><select name="completionmode"><option value="open">После открытия из маршрута</option><option value="ack">После подтверждения ознакомления</option></select></label><label><span>Повторное прохождение</span><select name="renewalpolicy"><option value="keep">Сохранить прошлый результат</option><option value="all">Отправить всех на повторное прохождение</option><option value="expiry">Повторять после срока действия</option><option value="manual">Назначать повтор вручную</option></select></label><label><span>Срок действия, дней</span><input type="number" min="0" max="3650" name="validdays" value="0"></label><label><span>Статус</span><select name="status"><option value="draft">Черновик</option><option value="published">Опубликовать для сотрудников</option></select></label></div><label class="u-route-editor__check"><input type="checkbox" name="required" value="1" checked> Обязательно для завершения точки</label><label class="u-route-editor__check"><input type="checkbox" name="previousadaptation" value="1"> Сначала завершить предыдущие обязательные шаги</label></fieldset><button class="u-btn u-btn--primary" type="submit">Добавить шаг</button>
    </form>
  </section>
  {{/caneditroute}}{{/route}}
{{/routeexists}}
</div>
