<nav class="u-library__crumbs" aria-label="Путь в каталоге"><a href="{{catalogroot}}">Все разделы</a>{{#breadcrumbs}}<span aria-hidden="true">/</span><a href="{{url}}">{{title}}</a>{{/breadcrumbs}}</nav>
{{#hasdetail}}{{#detail}}<article class="u-library__section u-library__detail"><div><p class="u-lcard__meta">{{typelabel}}{{#sku}} · {{sku}}{{/sku}}</p><h2>{{title}}</h2><p>{{summary}}</p>{{#hasimage}}<img class="u-library__productimage" src="{{imageurl}}" alt="{{title}}">{{/hasimage}}
{{#descriptionhtml}}<div class="u-richtext">{{{descriptionhtml}}}</div>{{/descriptionhtml}}
{{#hasattrs}}<dl class="u-library__attributes">{{#attrs}}<div><dt>{{name}}</dt><dd>{{value}}</dd></div>{{/attrs}}</dl>{{/hasattrs}}
{{#hassource}}<a class="u-btn" href="{{sourceurl}}">Скачать {{sourcefilename}}</a>{{/hassource}}</div></article>{{/detail}}{{/hasdetail}}
{{^hasdetail}}{{#hascards}}<div class="u-library__grid u-library__grid--dense">{{#cards}}<a class="u-lcard u-lcard--link" href="{{url}}">{{#hasimage}}<img class="u-lcard__image" src="{{imageurl}}" alt="" loading="lazy">{{/hasimage}}{{^hasimage}}<div class="u-lcard__placeholder" aria-hidden="true">U<span>STAR</span></div>{{/hasimage}}<div class="u-lcard__body"><p class="u-lcard__meta">{{typelabel}}{{#sku}} · {{sku}}{{/sku}}</p><h2 class="u-lcard__title">{{title}}</h2><p class="u-lcard__summary">{{summary}}</p>{{#locked}}<span class="u-badge">Доступ по условиям</span>{{/locked}}</div></a>{{/cards}}</div>{{/hascards}}{{^hascards}}<div class="u-empty"><h2>Ничего не найдено</h2><p>Измените запрос или выберите другой раздел.</p></div>{{/hascards}}{{/hasdetail}}
