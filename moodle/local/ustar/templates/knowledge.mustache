<div class="u-knowledge">
    <header class="u-knowledge-head">
        <div>
            <p class="u-pagehead__eyebrow">USTAR Knowledge</p>
            <h1>Моя библиотека</h1>
            <p>Изученные материалы маршрута и файлы, которые вы сохранили из ленты.</p>
        </div>
        <div class="u-knowledge-count"><strong>{{total}}</strong><span>доступно</span></div>
    </header>

    <section class="u-knowledge-cockpit" aria-label="Сводка личной библиотеки">
        <article class="u-knowledge-metric">{{{knowledgeicon}}}<div><strong>{{total}}</strong><span>в личной библиотеке</span></div></article>
        <article class="u-knowledge-metric">{{{checkicon}}}<div><strong>{{needsactioncount}}</strong><span>нужно ознакомиться</span></div></article>
        <article class="u-knowledge-metric">{{{clockicon}}}<div><strong>{{recentcount}}</strong><span>обновлено недавно</span></div></article>
        <article class="u-knowledge-metric">{{{searchicon}}}<div><strong>{{categorycount}}</strong><span>категорий в доступе</span></div></article>
    </section>

    <form class="u-knowledge-search" method="get">
        <input type="hidden" name="view" value="knowledge">
        <input type="search" name="q" value="{{q}}" placeholder="Найти регламент, инструкцию, материал..." aria-label="Поиск по базе знаний" autocomplete="off">
        <button class="u-btn u-btn--primary" type="submit">Найти</button>
    </form>

    {{#hascategoryshortcuts}}
    <nav class="u-knowledge-category-shortcuts" aria-label="Популярные категории">
        {{#categoryshortcuts}}<a href="{{url}}"><strong>{{label}}</strong><span>{{count}} материалов</span></a>{{/categoryshortcuts}}
    </nav>
    {{/hascategoryshortcuts}}

    <div class="u-knowledge-filter-stack">
        <nav class="u-knowledge-filters" aria-label="Тип материала">
            {{#typefilters}}<a href="{{url}}" class="u-knowledge-filter {{#selected}}is-active{{/selected}}"><span>{{label}}</span><strong>{{count}}</strong></a>{{/typefilters}}
        </nav>
        <nav class="u-knowledge-filters u-knowledge-filters--categories" aria-label="Категория">
            {{#categoryfilters}}<a href="{{url}}" class="u-knowledge-filter {{#selected}}is-active{{/selected}}"><span>{{label}}</span><strong>{{count}}</strong></a>{{/categoryfilters}}
        </nav>
    </div>

    {{#hasactionmaterials}}
    <section class="u-knowledge-action-zone">
        <header class="u-knowledge-section-head"><div><p class="u-sectionhead__eyebrow">Требует внимания</p><h2>Нужно ознакомиться</h2></div><strong>{{needsactioncount}}</strong></header>
        <div class="u-knowledge-grid">{{#actionmaterials}}{{> local_ustar/knowledge_card }}{{/actionmaterials}}</div>
    </section>
    {{/hasactionmaterials}}

    {{#hasrecentmaterials}}
    <section class="u-knowledge-recent-zone">
        <header class="u-knowledge-section-head"><div><p class="u-sectionhead__eyebrow">Fresh</p><h2>Недавно обновлено</h2></div><strong>{{recentcount}}</strong></header>
        <div class="u-knowledge-grid">{{#recentmaterials}}{{> local_ustar/knowledge_card }}{{/recentmaterials}}</div>
    </section>
    {{/hasrecentmaterials}}

    {{#hasregularmaterials}}
    <section class="u-knowledge-library-zone">
        <header class="u-knowledge-section-head"><div><p class="u-sectionhead__eyebrow">Личная история</p><h2>Все изученные материалы</h2></div></header>
        <div class="u-knowledge-grid">{{#regularmaterials}}{{> local_ustar/knowledge_card }}{{/regularmaterials}}</div>
    </section>
    {{/hasregularmaterials}}

    {{#hasfeedfiles}}
    <section class="u-knowledge-library-zone" id="saved-feed-files">
        <header class="u-knowledge-section-head"><div><p class="u-sectionhead__eyebrow">Моя коллекция</p><h2>Сохранено из ленты</h2></div><strong>{{feedfilecount}}</strong></header>
        <div class="u-knowledge-grid">
            {{#feedfiles}}
            <article class="u-knowledge-card">
                <div class="u-knowledge-card__meta"><span>Файл из ленты</span><span>{{size}}</span></div>
                <div class="u-knowledge-card__titleline">{{{knowledgeicon}}}<h2>{{title}}</h2></div>
                <p class="u-knowledge-card__summary">Личная копия вложения публикации.</p>
                <footer><small>Сохранено · {{date}}</small><a class="u-btn u-btn--primary" href="{{url}}">Скачать</a></footer>
                <form method="post" action="{{removeurl}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="action" value="removefeedfile">
                    <input type="hidden" name="savedid" value="{{id}}">
                    <button type="submit" class="u-btn u-btn--secondary">Убрать из библиотеки</button>
                </form>
            </article>
            {{/feedfiles}}
        </div>
        {{#hasmorefeedfiles}}<a class="u-btn u-btn--secondary" href="{{nextfeedurl}}#saved-feed-files">Ещё сохранённые файлы</a>{{/hasmorefeedfiles}}
    </section>
    {{/hasfeedfiles}}

    {{^hasmaterials}}
    <div class="u-knowledge-empty" role="status">
        {{{knowledgeicon}}}
        {{#hasactivefilters}}
        <strong>Ничего не найдено</strong>
        <p>В личной библиотеке нет материалов, соответствующих поиску или выбранным фильтрам.</p>
        <a class="u-btn" href="{{reseturl}}">Сбросить поиск и фильтры</a>
        {{/hasactivefilters}}
        {{^hasactivefilters}}
        <strong>В личной библиотеке пока ничего нет</strong>
        <p>Откройте материал маршрута или сохраните вложение публикации из ленты.</p>
        <a class="u-btn u-btn--primary" href="{{learningurl}}">Перейти к моему маршруту</a>
        {{/hasactivefilters}}
    </div>
    {{/hasmaterials}}
</div>
