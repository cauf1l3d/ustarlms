<div class="u-product-page u-achievements">
<header class="u-product-head"><div><p class="u-page-kicker">Прогресс, признание и соревнование</p><h1>Достижения</h1><p>XP показывает учебную активность, USCOIN — внутренняя игровая единица Академии. Расход монет не уменьшает рейтинг.</p></div>{{{trophyicon}}}</header>
<div class="u-achievements-hero-grid">
<section class="u-level-card"><div class="u-level-emblem">{{level}}</div><div class="u-level-card__body"><span>Уровень {{level}}</span><strong>{{xp}} XP</strong><div class="u-progress u-progress--large"><span style="width:{{pct}}%"></span></div><small>Следующий ориентир: {{nextxp}} XP</small></div></section>
<section class="u-coin-card"><span>USCOIN</span><strong>◉ {{coinbalance}}</strong><div><small>Заработано {{coinearned}}</small><small>Потрачено {{coinspent}}</small></div></section>
</div>
<div class="u-stat-grid u-stat-grid--3"><article class="u-stat-card">{{{gameicon}}}<span>Игровые задания</span><strong>{{gamexp}} XP</strong><small>игровой опыт</small></article><article class="u-stat-card">{{{staricon}}}<span>Курсы</span><strong>{{completedCourses}}</strong><small>завершено</small></article><article class="u-stat-card">{{{trophyicon}}}<span>Активность</span><strong>{{activeDays30}}</strong><small>дней за 30 дней</small></article></div>
<section class="u-panel u-leaderboard"><header class="u-panel-title"><div><p class="u-page-kicker">Сезонное соревнование</p><h2>{{#hascompetition}}{{competitiontitle}}{{/hascompetition}}{{^hascompetition}}Рейтинг временно закрыт{{/hascompetition}}</h2>{{#hascompetition}}<small>{{competitionprivacy}} · правило v{{competitionruleversion}} · до {{competitionenddate}}</small>{{/hascompetition}}</div></header>
{{#hascompetition}}
{{#hastop}}<div class="u-podium">{{#top}}<article class="u-podium-card"><b>{{medal}}</b><div class="u-person-dot">{{initials}}</div><strong>{{displayname}}</strong><span>{{#sharedplace}}Совместное место{{/sharedplace}}{{^sharedplace}}Индивидуальное место{{/sharedplace}}</span><em>{{points}} баллов</em></article>{{/top}}</div>{{/hastop}}
{{#hasrankrows}}<div class="u-rank-table">{{#rankrows}}<article class="u-rank-row {{#current}}is-current{{/current}}"><b>#{{rank}}</b><div class="u-person-dot">{{initials}}</div><div><strong>{{displayname}}</strong><small>{{#sharedplace}}Совместное место{{/sharedplace}}{{^sharedplace}}Участник сезона{{/sharedplace}}</small></div><span>{{points}} баллов</span></article>{{/rankrows}}</div>{{/hasrankrows}}
{{#currentrank}}<div class="u-current-rank"><span>Ваша позиция</span><strong>#{{rank}} · {{points}} баллов</strong><small>USCOIN не влияет на соревнование</small></div>{{/currentrank}}
{{/hascompetition}}
{{^hascompetition}}<div class="u-empty-state u-empty-state--product"><h3>Нет активного сезона</h3><p>Соревнования публикуются отдельно, с фиксированной аудиторией и версией правил. USCOIN никогда не используется для расчёта места.</p></div>{{/hascompetition}}
</section>
<div class="u-achievement-columns"><section class="u-panel"><header class="u-panel-title"><div><p class="u-page-kicker">Награды</p><h2>Коллекция</h2></div></header>{{#hasbadges}}<div class="u-badge-grid">{{#badges}}<article class="u-badge-card">{{{icon}}}<div><strong>{{name}}</strong><small>{{date}}</small></div></article>{{/badges}}</div>{{/hasbadges}}{{^hasbadges}}<div class="u-empty-mini">Первая награда ещё впереди.</div>{{/hasbadges}}</section>
<section class="u-panel"><header class="u-panel-title"><div><p class="u-page-kicker">Кошелёк</p><h2>История USCOIN</h2></div></header>{{#hascoinhistory}}<div class="u-coin-history">{{#coinhistory}}<div><b>{{#positive}}+{{/positive}}{{amount}}</b><span>{{comment}}</span><small>{{date}}</small></div>{{/coinhistory}}</div>{{/hascoinhistory}}{{^hascoinhistory}}<div class="u-empty-mini">Монеты появятся после первого подтверждённого события.</div>{{/hascoinhistory}}</section></div>
</div>
