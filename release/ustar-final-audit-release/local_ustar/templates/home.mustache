
{{! ==========================================================
    EMPLOYEE HOME
    ========================================================== }}

{{#viewhome}}

<section class="u-home-hero">
    <div class="u-home-hero__brand">
        <img src="{{homebannerurl}}" alt="USTAR Академия">
    </div>
    <div class="u-home-hero__welcome">
        <p class="u-pagehead__eyebrow">Личное пространство</p>
        <h1>Добро пожаловать, {{firstname}}</h1>
        <p>Ваше обучение, рабочие знания и развитие — в одном пространстве.</p>
        <a href="{{profileurl}}">Открыть личный кабинет →</a>
    </div>
</section>


{{#hashomenext}}
{{#homenext}}

<section class="u-next-card u-next-card--real">

    <div class="u-next-card__body">

        <p class="u-next-card__label">
            Следующее действие
        </p>

        <h2>
            {{name}}
        </h2>


        {{#hasnextactivity}}

        <p class="u-next-card__focus">
            Дальше · {{nextactivityname}}
        </p>

        {{/hasnextactivity}}


        <div class="u-next-card__meta">

            {{#hasprogress}}

            <div class="u-progressline">

                <div class="u-progressline__top">

                    <span>
                        {{stepslabel}}
                    </span>

                    <strong>
                        {{progress}}%
                    </strong>

                </div>

                <div
                    class="u-progressbar"
                    role="progressbar"
                    aria-valuemin="0"
                    aria-valuemax="100"
                    aria-valuenow="{{progress}}"
                >
                    <span
                        style="width: {{progress}}%"
                    ></span>
                </div>

            </div>

            {{/hasprogress}}


            {{^hasprogress}}

            <p class="u-course-muted">
                {{stepslabel}}
            </p>

            {{/hasprogress}}

        </div>


        <a
            class="u-primary-action"
            href="{{actionurl}}"
        >
            {{actionlabel}}
        </a>

    </div>

    <div class="u-next-card__media"><img src="{{coverurl}}" alt="Обложка курса {{name}}"></div>


</section>

{{/homenext}}
{{/hashomenext}}


{{^hashomenext}}

<section class="u-empty-state">

    <p class="u-empty-state__eyebrow">
        Обучение
    </p>

    <h2>
        Пока нет следующего действия
    </h2>

    <p>
        Когда появится назначенный курс или учебный путь,
        он будет показан здесь.
    </p>

</section>

{{/hashomenext}}


<div class="u-home-grid">

    <a
        class="u-home-tile u-home-tile--icon"
        href="{{learningurl}}"
    >

        {{{bookicon}}}

        <span class="u-home-tile__label">
            Обучение
        </span>

        <strong>
            Мой учебный путь
        </strong>

        <p>
            Продолжайте назначенные курсы и возвращайтесь
            к незавершённым материалам.
        </p>

        <span class="u-home-tile__footer">
            Learning
        </span>

    </a>


    <a
        class="u-home-tile u-home-tile--icon"
        href="{{knowledgeurl}}"
    >

        {{{knowledgeicon}}}

        <span class="u-home-tile__label">
            Рабочие знания
        </span>

        <strong>
            База знаний
        </strong>

        <p>
            Инструкции, стандарты, продукты
            и быстрый поиск ответа в работе.
        </p>

        <span class="u-home-tile__footer">
            Knowledge Market
        </span>

    </a>


    <a
        class="u-home-tile u-home-tile--icon"
        href="{{careerurl}}"
    >

        {{{sparkicon}}}

        <span class="u-home-tile__label">
            Развитие
        </span>

        <strong>
            Навыки и карьера
        </strong>

        <p>
            Требования должности, уровень развития
            и следующий карьерный шаг.
        </p>

        <span class="u-home-tile__footer">
            Skills · Career
        </span>

    </a>

    <a class="u-home-tile u-home-tile--icon" href="{{profileurl}}">
        {{{profileicon}}}
        <span class="u-home-tile__label">Личный кабинет</span>
        <strong>Мой профиль</strong>
        <p>Прогресс, навыки, награды, сообщения и личные настройки.</p>
        <span class="u-home-tile__footer">Profile</span>
    </a>

</div>

{{/viewhome}}



