{{! Canonical artwork supplied by USTAR. Moodle owns tokens, credentials, errors, reset and SSO. }}
{{> theme_boost/head }}
<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="u-login-page">
    {{{ output.standard_top_of_body_html }}}
    <main id="page" class="u-login-shell" aria-label="Вход в USTAR Академию">
        <section class="u-login-brand" aria-label="Академия USTAR">
            <img src="{{loginposterurl}}" width="468" height="530" class="u-login-poster"
                alt="Академия USTAR. Обучение, навыки, твоя карьера, игры и развитие — в одном рабочем пространстве. Экспресс Маркет и Хозмагия.">
        </section>
        <section class="u-login-auth" aria-label="Авторизация">
            <img src="{{loginwordmarkurl}}" width="273" height="42" class="u-login-wordmark" alt="USTAR">
            <h1 class="u-login-start"><img src="{{loginstarturl}}" width="333" height="33" alt="Начни с входа"></h1>
            <div class="u-login-auth__card">
                <div id="region-main" class="u-login-core">{{{ output.main_content }}}</div>
            </div>
            <footer class="u-login-auth__footer">
                <p>USTAR Академия использует авторские технологии и собственные разработанные сервисы обучения на основе ядра Moodle.</p>
                <strong>Тут растут эксперты</strong>
                <small>© USTAR Академия. 2026 Все права защищены</small>
            </footer>
        </section>
    </main>
    {{> theme_boost/footer }}
</div>
</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() { M.util.js_complete('theme_boost/loader'); });
{{/js}}
