<section class="u-checklists-tab" aria-label="Рабочие чек-листы">
    <div class="u-checklists-tab__toolbar">
        <form method="get" action="{{tasksurl}}">
            <input type="hidden" name="tab" value="checklists">
            {{#selectedid}}<input type="hidden" name="id" value="{{selectedid}}">{{/selectedid}}
            <label for="u-checklist-date">Рабочая дата</label>
            <input id="u-checklist-date" type="date" name="date" value="{{date}}" required>
            <button class="u-btn u-btn--quiet" type="submit">Показать</button>
        </form>
        {{#canstudio}}<a class="u-btn u-btn--quiet" href="{{studiourl}}">Редактор чек-листов</a>{{/canstudio}}
    </div>

    {{#haschecklists}}
    <div class="u-checklist-layout">
        <nav class="u-checklist-nav" aria-label="Доступные чек-листы">
            {{#checklists}}
            <a href="{{url}}" class="u-checklist-nav__item {{#complete}}is-complete{{/complete}}" {{#selected}}aria-current="page"{{/selected}}>
                <div><strong>{{title}}</strong><small>{{today.done}} / {{today.total}} · {{today.status}}</small></div>
                <span>{{progress}}%</span>
            </a>
            {{/checklists}}
        </nav>
        <section class="u-checklist-sheet">
            {{#current}}
            <header><p class="u-page-kicker">{{recurrence}}</p><h2>{{title}}</h2><p>{{description}}</p></header>
            {{#legacy}}<p class="u-inline-notice">Это выполнение сохранено до фиксации версии шаблона. Исторические ответы доступны только для просмотра.</p>{{/legacy}}
            {{#canedit}}<form method="post" action="{{tasksurl}}">{{/canedit}}
            {{#canedit}}
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="tab" value="checklists">
                <input type="hidden" name="action" value="checklistsave">
                <input type="hidden" name="checklistid" value="{{id}}">
                <input type="hidden" name="revision" value="{{today.revision}}">
                <input type="hidden" name="definitionversion" value="{{definitionversion}}">
            {{/canedit}}
                {{#sections}}
                <fieldset class="u-check-section"><legend>{{title}}</legend>
                    {{#items}}<label class="u-check-item"><input type="checkbox" name="done_{{fieldid}}" value="1" {{#checked}}checked{{/checked}} {{^canedit}}disabled{{/canedit}}><span>{{title}}</span></label>
                    <label class="u-field"><span>Примечание к пункту</span><input type="text" name="comment_{{fieldid}}" value="{{comment}}" placeholder="При необходимости" {{^canedit}}readonly{{/canedit}}></label>{{/items}}
                </fieldset>
                {{/sections}}
                <label class="u-field"><span>Комментарий к выполнению</span><textarea name="comment" rows="3" placeholder="Необязательно" {{^canedit}}readonly{{/canedit}}>{{todaycomment}}</textarea></label>
                {{#canedit}}
                {{#hasfinal}}<label class="u-field"><span>Причина исправления</span><textarea name="correctionreason" rows="2" placeholder="Укажите, почему меняете отправленный чек-лист"></textarea></label>{{/hasfinal}}
                {{^hasfinal}}<button class="u-btn u-btn--quiet" type="submit" name="mode" value="draft">Сохранить черновик</button>{{/hasfinal}}
                <button class="u-btn u-btn--primary" type="submit" name="mode" value="final">{{#hasfinal}}Отправить исправление{{/hasfinal}}{{^hasfinal}}Отправить выполнение{{/hasfinal}}</button>
            </form>
            {{/canedit}}
            {{^canedit}}<p>Это сохранённые ответы за выбранную дату. Изменения доступны только за сегодня.</p>{{/canedit}}
            {{/current}}
        </section>
    </div>
    {{/haschecklists}}
    {{^haschecklists}}<div class="u-stage6-card u-tasks__empty">На эту дату доступных чек-листов нет.</div>{{/haschecklists}}
</section>
