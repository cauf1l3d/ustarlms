<section class="uw-panel uw-editor ur-conditions" data-reward-conditions data-resources="{{resourcejson}}">
<div class="uw-panel-head"><div><h2>Условия начисления</h2><p>Настройте награду за реальные подтверждённые события.</p></div><a class="uw-btn uw-primary" href="#reward-new-condition" data-open-condition>+ Новое условие</a></div>
<p class="uw-footnote">Условие заменяет базовую награду для выбранного события. Если подходят несколько условий, применяется последнее добавленное. Ранее начисленные суммы сохраняются.</p>
{{#hasconditions}}<div class="ur-rule-list">{{#rows}}<article class="ur-rule"><header><h3>{{title}}</h3><span class="uw-badge">{{#active}}Включено{{/active}}{{^active}}Отключено{{/active}}</span></header><dl><div><dt>За что</dt><dd>{{kindlabel}}</dd></div><div><dt>Где</dt><dd>{{resourcelabel}}</dd></div><div><dt>Кому</dt><dd>{{wholabel}}</dd></div><div><dt>Когда</dt><dd>{{period}}</dd></div><div><dt>Сколько</dt><dd>{{xp}} XP · {{coins}} USCOIN</dd></div></dl>{{#active}}<details><summary>Отключить для будущих событий</summary><form method="post" action="{{url}}" class="uw-form"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="disable"><input type="hidden" name="conditionid" value="{{id}}"><input type="hidden" name="revision" value="{{revision}}"><label class="uw-field"><span>Причина</span><input name="reason" required maxlength="2000"></label><button class="uw-btn">Отключить условие</button></form></details>{{/active}}</article>{{/rows}}</div>{{/hasconditions}}
{{^hasconditions}}<p class="uw-empty">Дополнительных условий пока нет. Применяются базовые награды.</p>{{/hasconditions}}
<details id="reward-new-condition"><summary class="uw-btn">Добавить условие</summary><form class="uw-form uw-form-grid" method="post" action="{{url}}">
<input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="condition"><input type="hidden" name="revision" value="{{revision}}">
<label class="uw-field"><span>Название условия</span><input name="conditiontitle" required maxlength="100" placeholder="Например, обучение нового отдела"></label>
<label class="uw-field"><span>За что начислять</span><select name="conditionkind"><option value="route">Подтверждение точки маршрута</option><option value="course">Завершение курса Moodle</option><option value="activity">Завершение учебной активности</option><option value="game">Первый верный ответ в игре</option><option value="task">Принятое поручение</option><option value="checklist">Принятый чек-лист</option></select></label>
<label class="uw-field"><span>Где: конкретный источник</span><select name="conditionresource"><option value="">Любой источник этого события</option></select><small>Для задач и чек-листов можно выбрать шаблон.</small></label>
<label class="uw-field"><span>Кому начислять</span><select name="conditionscope"><option value="company">Всей компании</option><option value="department">Подразделению</option><option value="position">Должности</option><option value="person">Конкретному сотруднику</option></select></label>
<label class="uw-field" data-scope="department" hidden><span>Подразделение</span><select name="scope_department"><option value="">Выберите подразделение</option>{{#departments}}<option value="{{id}}">{{name}}</option>{{/departments}}</select></label>
<label class="uw-field" data-scope="position" hidden><span>Должность</span><select name="scope_position"><option value="">Выберите должность</option>{{#positions}}<option value="{{id}}">{{name}}</option>{{/positions}}</select></label>
<label class="uw-field" data-scope="person" hidden><span>Сотрудник</span><select name="scope_person"><option value="">Выберите сотрудника</option>{{#people}}<option value="{{id}}">{{name}}</option>{{/people}}</select></label>
<label class="uw-field"><span>Начало действия</span><input type="date" name="fromdate" required value="{{tomorrow}}"><small>По вашему часовому поясу, с 00:00; только будущие события.</small></label><label class="uw-field"><span>Окончание · необязательно</span><input type="date" name="untildate"></label>
<label class="uw-field"><span>XP за событие</span><input type="number" name="conditionxp" min="0" max="10000" value="10" required></label><label class="uw-field"><span>USCOIN за событие</span><input type="number" name="conditioncoins" min="0" max="10000" value="0" required><small data-coin-hint>Монеты начисляются за точку маршрута или принятую рабочую задачу.</small></label>
<label class="uw-field"><span>Причина добавления</span><textarea name="reason" required maxlength="2000"></textarea></label><div><button class="uw-btn uw-primary">Сохранить условие</button></div></form></details>
</section>
