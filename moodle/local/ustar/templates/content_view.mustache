<div class="u-content-view">

    <header class="u-content-view__head">

        <div>

            <a
                class="u-content-view__back"
                href="{{returnurl}}"
            >
                ← Назад
            </a>

            <p class="u-pagehead__eyebrow">
                {{#hasroutecontext}}МАТЕРИАЛ МАРШРУТА{{/hasroutecontext}}
                {{^hasroutecontext}}USTAR Content{{/hasroutecontext}}
            </p>

            <h1>
                {{title}}
            </h1>

            <div class="u-content-view__meta">

                <span>
                    {{versionlabel}}
                </span>

                <span>
                    {{filename}}
                </span>

                <span>
                    {{filesize}}
                </span>

            </div>

        </div>

    </header>


    <main class="u-content-view__body">


        {{#ishtml}}

        <div class="u-content-view__interactive">

            <div class="u-content-view__notice">

                <span>
                    Интерактивный материал
                </span>

                <small>
                    Запущен в изолированной среде USTAR.
                </small>

            </div>


            <iframe
                class="u-content-view__frame"
                src="{{fileurl}}"
                title="{{title}}"
                sandbox="allow-scripts"
                referrerpolicy="no-referrer"
                loading="eager"
            ></iframe>

        </div>

        {{/ishtml}}


        {{#ispdf}}

        <iframe
            class="
                u-content-view__frame
                u-content-view__frame--document
            "
            src="{{fileurl}}"
            title="{{title}}"
        ></iframe>

        {{/ispdf}}


        {{#isimage}}

        <div class="u-content-view__image">

            <img
                src="{{fileurl}}"
                alt="{{title}}"
            >

        </div>

        {{/isimage}}


        {{#isvideo}}

        <div class="u-content-view__video">

            <div class="u-content-view__video-stage">

                <video
                    src="{{fileurl}}"
                    controls
                    playsinline
                    preload="metadata"
                    title="{{title}}"
                ></video>

            </div>

            {{#hassummary}}
            <div class="u-content-view__video-summary">
                {{{summary}}}
            </div>
            {{/hassummary}}

        </div>

        {{/isvideo}}


        {{#hasdocxpreview}}

        <section class="u-content-view__docx">

            <header class="u-content-view__docxbar">
                <div>
                    <strong>Предпросмотр документа</strong>
                    <span>{{filename}} · {{filesize}}</span>
                </div>

                <a
                    class="u-btn"
                    href="{{downloadurl}}"
                >
                    Скачать файл
                </a>
            </header>

            <div class="u-content-view__docxstage">
                <article class="u-docx-preview">
                    {{{docxhtml}}}
                </article>
            </div>

        </section>

        {{/hasdocxpreview}}



        {{#isgeneric}}

        <div class="u-content-view__generic">

            <strong>
                {{filename}}
            </strong>

            <span>
                {{mimetype}} · {{filesize}}
            </span>

            <a
                class="u-btn u-btn--primary"
                href="{{downloadurl}}"
            >
                Скачать файл
            </a>

        </div>

        {{/isgeneric}}


    </main>



    {{#ackrequired}}

    <section
        class="
            u-content-ack
            {{#acked}}is-acked{{/acked}}
        "
    >

        <div class="u-content-ack__body">

            <p class="u-sectionhead__eyebrow">
                Ознакомление
            </p>


            {{#needsack}}

            <h2>
                {{#hasroutecontext}}Завершить материал{{/hasroutecontext}}
                {{^hasroutecontext}}Подтвердите ознакомление{{/hasroutecontext}}
            </h2>

            <p>
                {{#hasroutecontext}}
                После подтверждения USTAR сохранит прохождение
                этой версии и откроет следующий шаг маршрута.
                {{/hasroutecontext}}

                {{^hasroutecontext}}
                Подтверждение будет сохранено именно
                для версии {{versionlabel}} этого материала.
                {{/hasroutecontext}}
            </p>

            {{/needsack}}


            {{#acked}}

            <h2>
                Ознакомление подтверждено
            </h2>

            <p>
                Версия {{versionlabel}} ·
                {{acktimeformatted}}
            </p>

            {{/acked}}

        </div>


        {{#needsack}}

        <form
            method="post"
            class="u-content-ack__action"
        >

            <input
                type="hidden"
                name="action"
                value="acknowledge"
            >

            <input
                type="hidden"
                name="contentid"
                value="{{id}}"
            >

            <input
                type="hidden"
                name="sesskey"
                value="{{sesskey}}"
            >

            {{#hasroutecontext}}
            <input type="hidden" name="routepointid" value="{{routepointid}}">
            <input type="hidden" name="routeversionid" value="{{routeversionid}}">
            {{/hasroutecontext}}


            {{^hasroutecontext}}
            <label class="u-content-ack__confirm">

                <input
                    type="checkbox"
                    required
                >

                <span>
                    Я ознакомился с материалом
                </span>

            </label>
            {{/hasroutecontext}}


            <button
                type="submit"
                class="u-btn u-btn--primary"
            >
                {{#hasroutecontext}}Завершить и продолжить →{{/hasroutecontext}}
                {{^hasroutecontext}}Подтвердить ознакомление{{/hasroutecontext}}
            </button>

        </form>

        {{/needsack}}


        {{#acked}}

        <div class="u-content-ack__status">
            ✓
        </div>

        {{/acked}}

    </section>

    {{/ackrequired}}

</div>
