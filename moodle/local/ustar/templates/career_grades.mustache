<section class="u-career-native u-consultant-career" aria-label="Консультантские грейды">
<header><p class="u-page-kicker">Карьерная лестница · Консультантские грейды</p>
<h2>Путь развития</h2>
{{#hasgrade}}<p>Должность <strong>{{gradepositionname}}</strong> · грейд <strong>{{gradename}}</strong></p>{{/hasgrade}}
{{^hasgrade}}<p>Грейд для этой должности не назначен.</p>{{/hasgrade}}
</header>
<ol class="u-consultant-ladder">
{{#grades}}<li class="u-consultant-grade{{#current}} is-current{{/current}}">
{{#current}}<span class="u-consultant-grade__current">Ваш текущий грейд</span>{{/current}}
<span class="u-consultant-grade__number">Грейд {{number}}</span><h3>{{name}}</h3>
<p class="u-consultant-grade__pay"><small>По документу грейдов</small><strong>{{pay}}</strong></p>
<details><summary>Критерии и условия</summary><p>{{period}}</p>
<ul>{{#criteria}}<li>{{text}}</li>{{/criteria}}</ul>
{{#haskpi}}<h4>Премия по KPI</h4><ul>{{#kpi}}<li>{{text}}</li>{{/kpi}}</ul>{{/haskpi}}
{{#note}}<p>{{note}}</p>{{/note}}
</details></li>{{/grades}}
</ol>
<p class="u-consultant-career__note">Переход на следующую ступень подтверждает только ваш действующий руководитель после прохождения маршрута и аттестаций.
{{#gradeeligible}}<p><a class="u-btn u-btn--primary" href="{{gradesurl}}">Отправить заявку на {{nextgradename}}</a></p>{{/gradeeligible}}
{{^gradeeligible}}<p><a class="u-btn" href="{{gradesurl}}">Проверить условия перехода</a></p>{{/gradeeligible}}</p>
</section>
