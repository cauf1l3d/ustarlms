{{#hasactive}}

<section class="u-learning-section">

    <header class="u-sectionhead">

        <div>

            <p class="u-sectionhead__eyebrow">
                Сейчас
            </p>

            <h2>
                В работе
            </h2>

        </div>

        <span>
            {{activecount}}
        </span>

    </header>


    <div class="u-course-grid">

        {{#activecourses}}

        <article class="u-course-card">

            <div class="u-course-card__top">

                <span
                    class="u-course-status
                           u-course-status--active"
                >
                    {{statuslabel}}
                </span>


                {{#hidden}}

                <span class="u-course-hidden">
                    {{hiddenlabel}}
                </span>

                {{/hidden}}

            </div>


            <h3>
                {{name}}
            </h3>


            {{#hascategory}}

            <p class="u-course-category">
                {{category}}
            </p>

            {{/hascategory}}


            {{#hasskills}}

            <div class="u-skill-chips">

                {{#skills}}

                <span>
                    {{name}}
                </span>

                {{/skills}}

            </div>

            {{/hasskills}}


            <div class="u-course-card__progress">

                {{#hasprogress}}

                <div class="u-progressline">

                    <div class="u-progressline__top">

                        <span>
                            {{stepslabel}}
                        </span>

                        <strong>
                            {{progress}}%
                        </strong>

                    </div>

                    <div
                        class="u-progressbar"
                        role="progressbar"
                        aria-valuemin="0"
                        aria-valuemax="100"
                        aria-valuenow="{{progress}}"
                    >
                        <span
                            style="width: {{progress}}%"
                        ></span>
                    </div>

                </div>

                {{/hasprogress}}


                {{^hasprogress}}

                <p class="u-course-muted">
                    {{stepslabel}}
                </p>

                {{/hasprogress}}

            </div>


            {{#hasnextactivity}}

            <p class="u-course-next">
                Дальше · {{nextactivityname}}
            </p>

            {{/hasnextactivity}}


            <a
                class="u-course-link"
                href="{{actionurl}}"
            >
                Продолжить
                <span aria-hidden="true">→</span>
            </a>

        </article>

        {{/activecourses}}

    </div>

</section>

{{/hasactive}}



