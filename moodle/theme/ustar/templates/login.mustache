{{! Canonical artwork supplied by USTAR. Moodle owns tokens, credentials, errors, reset and SSO. }}
{{> theme_boost/head }}
<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="ustar-auth-page">
    {{{ output.standard_top_of_body_html }}}
    <main id="page" class="ustar-auth-shell" aria-label="Вход в USTAR Академию">
        <section class="ustar-auth-brand" aria-label="Академия USTAR">
            <svg class="ustar-auth-artwork" viewBox="155 50 711 836" preserveAspectRatio="xMidYMid meet" role="img" aria-label="USTAR: обучение, навыки, карьера, игры. Развивайся, строй карьеру, участвуй в играх, будь частью команды.">
                <image href="{{loginreferenceurl}}" x="0" y="0" width="1672" height="941" />
            </svg>
        </section>
        <section class="ustar-auth-auth" aria-label="Авторизация">
            <svg class="ustar-auth-logo" viewBox="1055 85 287 100" preserveAspectRatio="xMidYMid meet" role="img" aria-label="USTAR Академия"><image href="{{loginreferenceurl}}" x="0" y="0" width="1672" height="941" /></svg>
            <h1 class="ustar-auth-start">Начни с входа</h1>
            <div class="ustar-auth-auth__card">
                <div id="region-main" class="ustar-auth-core">{{{ output.main_content }}}</div>
                {{#signupenabled}}
                <div class="ustar-auth-signup" aria-label="Регистрация в USTAR Академии">
                    <span>Впервые в Академии?</span>
                    <a class="btn btn-secondary" href="{{signupurl}}">Зарегистрироваться</a>
                </div>
                {{/signupenabled}}
            </div>
            <footer class="ustar-auth-auth__footer">
                <p>USTAR Академия использует авторские технологии и собственные разработанные сервисы обучения на основе ядра Moodle.</p>
                <strong>Тут растут эксперты</strong>
                <small>© USTAR Академия. 2026 Все права защищены</small>
            </footer>
        </section>
    </main>
    {{> theme_boost/footer }}
</div>
</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() { M.util.js_complete('theme_boost/loader'); });
{{/js}}
