<div class="u-workspace un-notebook" data-notebook data-url="{{url}}" data-sesskey="{{sesskey}}" data-revision="{{revision}}" data-board="{{boardjson}}">
 <header class="uw-heading"><div><span class="uw-eyebrow">Личное пространство</span><h1>Личный блокнот</h1><p>Перетаскивайте карточки, меняйте размер за нижний угол. Соединяйте заметки за круглую точку; выделяйте их для объединения во фрейм.</p></div><a class="uw-btn" href="{{tasksurl}}">К задачам</a></header>
 {{#notice}}<div class="uw-notice" role="alert">{{notice}} Если добавляли файлы, выберите их повторно.</div>{{/notice}}
 <details class="uw-panel uw-editor" {{#createopen}}open{{/createopen}}><summary>+ Новая заметка</summary>
  <form method="post" action="{{url}}" enctype="multipart/form-data" class="uw-form">
   <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="create">
   <label class="uw-field"><span>Название</span><input name="title" required maxlength="255" value="{{createtitle}}"></label>
   <label class="uw-field"><span>Текст</span><textarea name="description" rows="4">{{createbody}}</textarea></label>
   <label class="uw-field"><span>Вложения (до 10 файлов)</span><input name="attachments[]" type="file" multiple></label>
   <button class="uw-btn uw-primary">Добавить на доску</button>
  </form>
 </details>
 <div class="un-toolbar"><form method="get" class="un-search"><label class="uw-field"><span>Найти заметку</span><input name="q" type="search" value="{{q}}"></label>
 <label class="uw-field"><span>Показать</span><select name="filter"><option value="all" {{#all}}selected{{/all}}>Все заметки</option><option value="active" {{#active}}selected{{/active}}>Открытые</option><option value="done" {{#done}}selected{{/done}}>Завершённые</option></select></label><button class="uw-btn">Найти</button></form>
 <div class="uw-actions" data-board-tools hidden><label class="un-color">Фон <select data-background aria-label="Фон доски"><option value="auto">По теме</option><option value="paper">Бумага</option><option value="cream">Кремовый</option><option value="mint">Мятный</option><option value="sky">Небесный</option><option value="rose">Розовый</option><option value="slate">Графит</option></select></label><button class="uw-btn" type="button" data-group>Создать фрейм из выделенных</button><button class="uw-btn" type="button" data-clear-selection>Снять выделение</button><button class="uw-btn" type="button" data-zoom="out" aria-label="Уменьшить масштаб">−</button><output data-zoom-label>100%</output><button class="uw-btn" type="button" data-zoom="in" aria-label="Увеличить масштаб">+</button><button class="uw-btn" type="button" data-zoom="reset">100%</button></div></div>
 <p class="uw-muted">Только ваши заметки · {{total}} · страница {{page}}</p><p class="un-save-status" role="status" aria-live="polite" data-save-status></p>
 <div class="un-viewport" tabindex="0" aria-label="Доска заметок. Прокручивайте, чтобы увидеть остальные карточки."><div class="un-sizer"><div class="un-canvas"><div class="un-frames" data-frames></div><svg class="un-links" data-links aria-label="Связи между заметками"></svg>
 {{#notes}}<article id="note-{{id}}" class="un-card" data-id="{{id}}" data-x="{{x}}" data-y="{{y}}" data-color="{{color}}" data-width="{{width}}" data-height="{{height}}" data-frame="{{frame}}">
  <div class="un-card-head"><label class="un-select" data-board-tools hidden><input type="checkbox" data-select aria-label="Выделить {{titleplain}}"></label><button type="button" class="un-handle" data-drag aria-label="Переместить {{titleplain}}. Используйте стрелки клавиатуры." title="Перетащите карточку или используйте стрелки">{{titleplain}} <span aria-hidden="true">⠿</span></button><button class="un-menu-toggle" type="button" data-menu-toggle aria-label="Действия с заметкой {{titleplain}}" aria-expanded="false">⋯</button></div>
  <div class="un-card-body"><div class="un-text">{{{description}}}</div>
   {{#files}}{{#image}}<a href="{{url}}" target="_blank" rel="noopener"><img class="un-image" src="{{url}}" alt="{{name}}" loading="lazy"></a>{{/image}}{{^image}}<a class="un-file" href="{{url}}" download>{{name}}</a>{{/image}}{{/files}}
   <span class="uw-badge {{^open}}uw-success{{/open}}">{{#open}}Открыта{{/open}}{{^open}}Завершена{{/open}}</span>
   </div><div class="un-card-menu" data-menu {{^editopen}}hidden{{/editopen}}>
   <label class="un-color" data-board-tools hidden>Цвет <select data-color-picker aria-label="Цвет {{titleplain}}"><option value="neutral">Нейтральный</option><option value="yellow">Жёлтый</option><option value="blue">Синий</option><option value="green">Зелёный</option><option value="pink">Розовый</option><option value="purple">Лиловый</option></select></label><label class="uw-field"><span>Фрейм</span><select data-frame-picker aria-label="Фрейм заметки"><option value="">Без фрейма</option></select></label>
   <details {{#editopen}}open{{/editopen}}><summary>Редактировать</summary><form method="post" action="{{url}}" enctype="multipart/form-data" class="uw-form"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="edit"><input type="hidden" name="id" value="{{id}}"><input type="hidden" name="version" value="{{version}}">
   <label class="uw-field"><span>Название</span><input name="title" value="{{titleplain}}" maxlength="255" required></label><label class="uw-field"><span>Текст</span><textarea name="description" rows="4">{{descriptionplain}}</textarea></label><label class="uw-field"><span>Добавить вложения</span><input type="file" name="attachments[]" multiple></label><button class="uw-btn uw-primary">Сохранить</button></form></details>
   {{#open}}<form method="post" action="{{url}}" class="uw-form"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="complete"><input type="hidden" name="id" value="{{id}}"><input type="hidden" name="version" value="{{version}}"><button class="uw-btn">Завершить заметку</button></form>{{/open}}
   <details><summary>Удалить</summary><form method="post" action="{{url}}" class="uw-form"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="{{id}}"><input type="hidden" name="version" value="{{version}}"><label class="uw-check"><input type="checkbox" name="confirmdelete" value="1" required>Удалить заметку и вложения</label><button class="uw-btn">Удалить</button></form></details>
  </div><button type="button" class="un-port" data-port data-board-tools hidden aria-label="Связать {{titleplain}} с другой заметкой" title="Перетащите на другую карточку или выберите две точки"></button><button type="button" class="un-resize" data-resize data-board-tools hidden aria-label="Размер {{titleplain}}. Используйте стрелки." title="Изменить размер">↘</button></article>{{/notes}}
 </div></div></div>{{^hasnotes}}<div class="uw-panel uw-empty">Заметок по выбранным условиям нет. Создайте новую или измените фильтр.</div>{{/hasnotes}}
 <nav class="uw-pagination" aria-label="Страницы блокнота">{{#previous}}<a class="uw-btn" href="{{previous}}">Назад</a>{{/previous}}{{#next}}<a class="uw-btn" href="{{next}}">Следующие 25</a>{{/next}}</nav>
</div>
